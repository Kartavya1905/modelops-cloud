# ModelOps Cloud — environment template.
# Run `pnpm env:init` to create `.env` from this file:
#   - every __GENERATE__ value is replaced by a random secret
#   - every ${VAR} reference is resolved once, at generation time
# `.env` is gitignored. Never commit real values.

# ---- Host ports (all bound to 127.0.0.1 only) -------------------------------
# Chosen to avoid common defaults (5432, 6379, 3000, 8080, 9090) used by other projects.
MO_PORT_POSTGRES=15432
MO_PORT_REDIS=16379
MO_PORT_S3=18333
MO_PORT_MLFLOW=15000
MO_PORT_API=4000
MO_PORT_WEB=3300
MO_PORT_ML_WORKER=18100
# M5: inference gateway (public + admin) and the Docker socket proxy (worker only).
# 18080 is avoided on purpose: other local projects use it.
MO_PORT_GATEWAY=18088
MO_PORT_GATEWAY_ADMIN=18089
MO_PORT_DOCKER_PROXY=12375
# M6: Prometheus (9090 is avoided on purpose: other local projects use it).
MO_PORT_PROMETHEUS=19090
# M10: observability profile (`pnpm dev:obs`): Grafana, Tempo (trace queries), OTLP/HTTP in.
MO_PORT_GRAFANA=13001
MO_PORT_TEMPO=13200
MO_PORT_OTLP_HTTP=14318

# ---- PostgreSQL --------------------------------------------------------------
MO_POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
MO_DB_APP_USER=modelops_app
MO_DB_APP_PASSWORD=__GENERATE__
MO_DB_MLFLOW_USER=mlflow
MO_DB_MLFLOW_PASSWORD=__GENERATE__
# M10: Grafana's read-only role (SELECT on a few operational tables; no users, sessions, keys, audit).
MO_DB_GRAFANA_USER=grafana_ro
MO_DB_GRAFANA_PASSWORD=__GENERATE__

# ---- Grafana (M10) -------------------------------------------------------------
MO_GRAFANA_ADMIN_PASSWORD=__GENERATE__

# ---- Redis -------------------------------------------------------------------
MO_REDIS_PASSWORD=__GENERATE__

# ---- S3-compatible object storage (SeaweedFS) --------------------------------
MO_S3_ACCESS_KEY=__GENERATE__
MO_S3_SECRET_KEY=__GENERATE__
MO_S3_REGION=us-east-1
# Second identity for the ML worker: READ-ONLY on the model-artifacts bucket (least privilege).
MO_S3_VALIDATOR_ACCESS_KEY=__GENERATE__
MO_S3_VALIDATOR_SECRET_KEY=__GENERATE__

# ---- ML worker (M4) ------------------------------------------------------------
# Shared secret the platform sends in X-ModelOps-Token when calling the ML worker.
MO_ML_WORKER_TOKEN=__GENERATE__

# ---- Deployments + inference (M5) ---------------------------------------------
# Shared secret for the gateway's internal admin API (worker probes, never public).
MO_GATEWAY_INTERNAL_TOKEN=__GENERATE__
# Server-side pepper for API keys: the database stores HMAC-SHA256(pepper, secret) only.
MO_API_KEY_PEPPER=__GENERATE__

# ---- Host-side application settings (API and web run on the host in dev) -----
MO_API_HOST=127.0.0.1
DATABASE_URL=postgresql://${MO_DB_APP_USER}:${MO_DB_APP_PASSWORD}@127.0.0.1:${MO_PORT_POSTGRES}/modelops
REDIS_URL=redis://:${MO_REDIS_PASSWORD}@127.0.0.1:${MO_PORT_REDIS}/0
MO_S3_ENDPOINT=http://127.0.0.1:${MO_PORT_S3}
MO_MLFLOW_URL=http://127.0.0.1:${MO_PORT_MLFLOW}
MO_API_URL=http://127.0.0.1:${MO_PORT_API}
MO_ML_WORKER_URL=http://127.0.0.1:${MO_PORT_ML_WORKER}
MO_DOCKER_PROXY_URL=http://127.0.0.1:${MO_PORT_DOCKER_PROXY}
MO_GATEWAY_URL=http://127.0.0.1:${MO_PORT_GATEWAY}
MO_GATEWAY_ADMIN_URL=http://127.0.0.1:${MO_PORT_GATEWAY_ADMIN}
MO_PROMETHEUS_URL=http://127.0.0.1:${MO_PORT_PROMETHEUS}
MO_WEB_URL=http://127.0.0.1:${MO_PORT_WEB}
# M10: traces from the API and worker (OTLP/HTTP to the collector). Unset to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:${MO_PORT_OTLP_HTTP}
# ...and from model servers, which reach the collector on the internal network.
MO_MODEL_SERVER_OTLP_ENDPOINT=http://otel-collector:4318

# ---- Auth (M2) ---------------------------------------------------------------
# Server-side secret used to derive CSRF tokens and hash IP addresses. Rotating it
# invalidates CSRF tokens (users simply reload) but not sessions.
MO_API_SESSION_PEPPER=__GENERATE__
# `true` adds the Secure flag to cookies. Keep `false` for http://127.0.0.1 in local dev.
MO_COOKIE_SECURE=false
