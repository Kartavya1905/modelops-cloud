{
  "name": "modelops-cloud",
  "private": true,
  "description": "Self-service ML training, registry, deployment, inference and monitoring platform",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev:up": "node scripts/compose.mjs up",
    "dev:down": "node scripts/compose.mjs down",
    "dev:ps": "node scripts/compose.mjs ps",
    "dev:logs": "node scripts/compose.mjs logs",
    "dev:clean": "node scripts/cleanup.mjs",
    "dev": "pnpm --parallel --filter @modelops/api --filter @modelops/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:smoke": "node scripts/smoke.mjs",
    "contract": "pnpm --filter @modelops/api build && pnpm --filter @modelops/api openapi:emit && pnpm --filter @modelops/api-contract generate",
    "test:integration": "pnpm --filter @modelops/api test:integration",
    "db:deploy": "pnpm --filter @modelops/api db:deploy",
    "db:migrate": "pnpm --filter @modelops/api db:migrate",
    "test:e2e": "pnpm --filter @modelops/e2e test",
    "screenshots": "pnpm --filter @modelops/e2e screenshots"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
