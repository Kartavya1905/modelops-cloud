{
  "name": "modelops-cloud",
  "private": true,
  "description": "Self-service ML training, registry, deployment, inference and monitoring platform",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev:up": "node scripts/compose.mjs up",
    "dev:obs": "node scripts/compose.mjs obs",
    "kind:up": "node scripts/kind.mjs up",
    "kind:down": "node scripts/kind.mjs down",
    "kind:smoke": "node scripts/kind-smoke.mjs",
    "dev:down": "node scripts/compose.mjs down",
    "dev:ps": "node scripts/compose.mjs ps",
    "dev:logs": "node scripts/compose.mjs logs",
    "dev:clean": "node scripts/cleanup.mjs",
    "dev": "pnpm --parallel --filter @modelops/api --filter @modelops/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:smoke": "node scripts/smoke.mjs",
    "check:hardening": "node scripts/hardening.mjs",
    "tf:check": "node scripts/terraform-check.mjs",
    "aws:up": "node scripts/aws-free.mjs up",
    "aws:status": "node scripts/aws-free.mjs status",
    "aws:start": "node scripts/aws-free.mjs start",
    "aws:stop": "node scripts/aws-free.mjs stop",
    "aws:smoke": "node scripts/aws-free.mjs smoke",
    "aws:down": "node scripts/aws-free.mjs down",
    "demo:traffic": "node scripts/demo-traffic.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:report": "node scripts/bench-report.mjs",
    "demo:drift": "node scripts/demo-drift.mjs",
    "contract": "pnpm --filter @modelops/api build && pnpm --filter @modelops/api openapi:emit && pnpm --filter @modelops/api-contract generate",
    "test:integration": "pnpm --filter @modelops/api test:integration",
    "test:chaos": "pnpm --filter @modelops/api build && pnpm --filter @modelops/api test:chaos",
    "db:deploy": "pnpm --filter @modelops/api db:deploy",
    "db:migrate": "pnpm --filter @modelops/api db:migrate",
    "test:e2e": "pnpm --filter @modelops/e2e e2e",
    "screenshots": "pnpm --filter @modelops/e2e screenshots",
    "ml:train": "node scripts/train-all.mjs",
    "ml:test": "uv run --directory ml pytest",
    "ml:lint": "uv run --directory ml ruff check . && uv run --directory ml ruff format --check ."
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
