// ModelOps Cloud — control-plane schema (M2: identity, tenancy, projects, audit; M3: registry).
// Design: docs/03-data-model.md. Table and column names are snake_case in Postgres.
// Every tenant-owned table carries org_id, and every query filters on it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  ML_ENGINEER
  VIEWER
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
}

enum TaskType {
  BINARY_CLASSIFICATION
}

/// Only frameworks whose export path produces a validated ONNX graph (ADR-0002).
enum ModelFramework {
  SKLEARN_ONNX
  PYTORCH_ONNX
}

/// PENDING_VALIDATION -> VALIDATING -> VALIDATED | REJECTED (M4 validator).
enum ModelVersionStatus {
  PENDING_VALIDATION
  VALIDATING
  VALIDATED
  REJECTED
}

enum ModelVersionSource {
  MLFLOW_RUN
  UPLOAD
}

/// PASSED/FAILED describe the model; ERROR means the validation could not run (infrastructure).
enum ValidationResult {
  PASSED
  FAILED
  ERROR
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed; uniqueness is therefore case-insensitive.
  email        String   @unique
  /// Argon2id hash (PHC string format).
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions            Session[]
  memberships         Membership[]
  invitationsCreated  Invitation[]         @relation("InvitationCreatedBy")
  invitationsAccepted Invitation[]         @relation("InvitationAcceptedBy")
  projectsCreated     Project[]
  modelsCreated       RegisteredModel[]
  versionsCreated     ModelVersion[]
  endpointsCreated    Endpoint[]
  revisionsRequested  DeploymentRevision[]
  apiKeysCreated      ApiKey[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque cookie token. The token itself is never stored.
  tokenHash         Bytes     @unique @map("token_hash")
  /// Sliding expiry (extended on use).
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Hard limit regardless of activity.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipHash            String?   @map("ip_hash")
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships      Membership[]
  invitations      Invitation[]
  projects         Project[]
  auditEvents      AuditEvent[]
  registeredModels RegisteredModel[]
  modelVersions    ModelVersion[]
  datasetVersions  DatasetVersion[]
  validations      ValidationReport[]
  endpoints        Endpoint[]
  revisions        DeploymentRevision[]
  apiKeys          ApiKey[]

  @@map("organizations")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  email        String
  role         Role
  /// SHA-256 of the one-time token in the invite link.
  tokenHash    Bytes     @unique @map("token_hash")
  createdById  String    @map("created_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User         @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([orgId, createdAt(sort: Desc)])
  @@map("invitations")
}

model Project {
  id                 String    @id @default(uuid()) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  slug               String
  name               String
  description        String?
  createdById        String    @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(3)
  /// MLflow experiment `modelops/<org-slug>/<project-slug>`, created on first use.
  mlflowExperimentId String?   @unique @map("mlflow_experiment_id")

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy        User              @relation(fields: [createdById], references: [id])
  registeredModels RegisteredModel[]
  datasetVersions  DatasetVersion[]
  endpoints        Endpoint[]
  apiKeys          ApiKey[]

  @@unique([orgId, slug])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("projects")
}

/// A dataset a model was trained on, identified by the SHA-256 of its canonical bytes.
model DatasetVersion {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  name            String
  /// Human label from the generator, e.g. `seed7-n20000`.
  version         String
  sha256          String   @db.Char(64)
  rowCount        Int?     @map("row_count")
  /// Where the bytes are, e.g. `runs:/<run-id>/dataset/train.csv`.
  uri             String
  generatorParams Json     @default("{}") @map("generator_params")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelVersions ModelVersion[]

  @@unique([projectId, sha256])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("dataset_versions")
}

model RegisteredModel {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  slug        String
  name        String
  description String?
  taskType    TaskType @default(BINARY_CLASSIFICATION) @map("task_type")
  /// Globally unique name in the MLflow Model Registry: `<org-slug>.<project-slug>.<model-slug>`.
  mlflowName  String   @unique @map("mlflow_name")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id])
  versions  ModelVersion[]

  @@unique([projectId, slug])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("registered_models")
}

/// An immutable, numbered version of a registered model, pointing at one MLflow run's bundle.
model ModelVersion {
  id                       String             @id @default(uuid()) @db.Uuid
  orgId                    String             @map("org_id") @db.Uuid
  modelId                  String             @map("model_id") @db.Uuid
  version                  Int
  framework                ModelFramework
  status                   ModelVersionStatus @default(PENDING_VALIDATION)
  source                   ModelVersionSource @default(MLFLOW_RUN)
  /// Null for uploaded bundles.
  mlflowRunId              String?            @map("mlflow_run_id")
  /// Version number in the MLflow registry mirror; null until the mirror call succeeds.
  mlflowVersion            String?            @map("mlflow_version")
  /// e.g. `mlflow-artifacts:/7/<run-id>/artifacts/model`. M4 copies it to content-addressed storage.
  sourceUri                String             @map("source_uri")
  /// SHA-256 reported by the training run; ingest recomputes it and rejects a mismatch.
  reportedSha256           String?            @map("reported_sha256") @db.Char(64)
  /// Content-addressed copies in `model-artifacts/blobs/sha256/<hash>` (set at ingest, immutable).
  artifactSha256           String?            @map("artifact_sha256") @db.Char(64)
  signatureSha256          String?            @map("signature_sha256") @db.Char(64)
  goldenSha256             String?            @map("golden_sha256") @db.Char(64)
  sizeBytes                Int?               @map("size_bytes")
  /// Validation bookkeeping: attempts so far and the lease of the worker currently validating.
  validationAttempts       Int                @default(0) @map("validation_attempts")
  validationLeaseUntil     DateTime?          @map("validation_lease_until") @db.Timestamptz(3)
  validatedAt              DateTime?          @map("validated_at") @db.Timestamptz(3)
  signature                Json
  /// Snapshot of the run's metrics at registration time.
  metrics                  Json               @default("{}")
  trainingDatasetVersionId String?            @map("training_dataset_version_id") @db.Uuid
  parentVersionId          String?            @map("parent_version_id") @db.Uuid
  createdById              String             @map("created_by_id") @db.Uuid
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  org             Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  model           RegisteredModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  trainingDataset DatasetVersion?      @relation(fields: [trainingDatasetVersionId], references: [id])
  parent          ModelVersion?        @relation("Lineage", fields: [parentVersionId], references: [id])
  children        ModelVersion[]       @relation("Lineage")
  createdBy       User                 @relation(fields: [createdById], references: [id])
  validations     ValidationReport[]
  revisions       DeploymentRevision[]

  @@unique([modelId, version])
  @@unique([modelId, mlflowRunId])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([status, validationLeaseUntil])
  @@map("model_versions")
}

/// One row per validation attempt (history is kept; the latest decides the status).
model ValidationReport {
  id               String           @id @default(uuid()) @db.Uuid
  orgId            String           @map("org_id") @db.Uuid
  versionId        String           @map("version_id") @db.Uuid
  attempt          Int
  result           ValidationResult
  /// [{ id: "V1", name, passed: true|false|null, detail }]
  checks           Json
  /// opset, operators, loadMs, peakRssMb, goldenMaxAbsDiff, latencyP50Ms/P95Ms, ...
  facts            Json             @default("{}")
  validatorVersion String           @map("validator_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  version ModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt(sort: Desc)])
  @@map("validation_reports")
}

/// Append-only: a trigger in the migration rejects UPDATE and DELETE.
model AuditEvent {
  id         BigInt    @id @default(autoincrement())
  /// Null for events that belong to a user rather than an organization (e.g. login).
  orgId      String?   @map("org_id") @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  /// `<aggregate>.<verb-past>`, e.g. `project.created`.
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  /// Never contains request bodies, passwords, tokens or raw IP addresses.
  metadata   Json      @default("{}")
  requestId  String?   @map("request_id")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, id(sort: Desc)])
  @@index([actorId, id(sort: Desc)])
  @@map("audit_events")
}

// ============================================================ M5: deployments + inference access

enum EndpointEnvironment {
  STAGING
  PRODUCTION
}

/// docs/05 §2. FAILED, CANCELLED and RETIRED are terminal (enforced by a trigger).
enum RevisionState {
  REQUESTED
  AWAITING_APPROVAL
  QUEUED
  PROVISIONING
  LOADING
  VERIFYING
  READY
  DEGRADED
  DRAINING
  RETIRED
  FAILED
  CANCELLED
}

/// A stable inference URL (`/v1/endpoints/<slug>/predict`) whose revisions change over time.
model Endpoint {
  id               String              @id @default(uuid()) @db.Uuid
  orgId            String              @map("org_id") @db.Uuid
  projectId        String              @map("project_id") @db.Uuid
  slug             String
  name             String
  description      String?
  environment      EndpointEnvironment @default(STAGING)
  /// The revision receiving traffic. Must belong to this endpoint (trigger).
  stableRevisionId String?             @unique @map("stable_revision_id") @db.Uuid
  rateLimitRps     Int                 @default(50) @map("rate_limit_rps")
  /// Optimistic-lock counter (ETag) for traffic settings (used from M8).
  rowVersion       Int                 @default(0) @map("row_version")
  createdById      String              @map("created_by_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  org            Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User                 @relation(fields: [createdById], references: [id])
  stableRevision DeploymentRevision?  @relation("StableRevision", fields: [stableRevisionId], references: [id])
  revisions      DeploymentRevision[] @relation("EndpointRevisions")

  @@unique([projectId, slug])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("endpoints")
}

/// One attempt to run one validated model version behind an endpoint (docs/05).
model DeploymentRevision {
  id                 String        @id @default(uuid()) @db.Uuid
  orgId              String        @map("org_id") @db.Uuid
  endpointId         String        @map("endpoint_id") @db.Uuid
  modelVersionId     String        @map("model_version_id") @db.Uuid
  revisionNumber     Int           @map("revision_number")
  state              RevisionState @default(REQUESTED)
  /// Compare-and-set counter: every transition is `WHERE state = $from AND state_version = $v`.
  stateVersion       Int           @default(0) @map("state_version")
  /// Every non-terminal state has a deadline, so nothing stays in progress forever.
  stateDeadlineAt    DateTime?     @map("state_deadline_at") @db.Timestamptz(3)
  /// `{ "cpus": 0.5, "memoryMb": 512 }`
  resources          Json          @default("{\"cpus\": 0.5, \"memoryMb\": 512}")
  failureCode        String?       @map("failure_code")
  failureDetail      String?       @map("failure_detail")
  /// Container name (`mo-rev-<id>`) or pod name.
  runtimeRef         String?       @map("runtime_ref")
  readyAt            DateTime?     @map("ready_at") @db.Timestamptz(3)
  /// DRAINING: keep the container warm until this time, then retire it.
  drainUntil         DateTime?     @map("drain_until") @db.Timestamptz(3)
  retiredAt          DateTime?     @map("retired_at") @db.Timestamptz(3)
  /// Self-healing budget: at most 3 restarts in a 10-minute window, then FAILED.
  restartCount       Int           @default(0) @map("restart_count")
  restartWindowStart DateTime?     @map("restart_window_start") @db.Timestamptz(3)
  previousRevisionId String?       @map("previous_revision_id") @db.Uuid
  requestedById      String        @map("requested_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoint     Endpoint          @relation("EndpointRevisions", fields: [endpointId], references: [id], onDelete: Cascade)
  modelVersion ModelVersion      @relation(fields: [modelVersionId], references: [id])
  requestedBy  User              @relation(fields: [requestedById], references: [id])
  stableFor    Endpoint?         @relation("StableRevision")
  events       DeploymentEvent[]

  @@unique([endpointId, revisionNumber])
  @@index([state, stateDeadlineAt])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("deployment_revisions")
}

/// The revision timeline: one row per state transition (written in the same transaction).
model DeploymentEvent {
  id         BigInt         @id @default(autoincrement())
  orgId      String         @map("org_id") @db.Uuid
  revisionId String         @map("revision_id") @db.Uuid
  fromState  RevisionState? @map("from_state")
  toState    RevisionState  @map("to_state")
  message    String
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  revision DeploymentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, id])
  @@map("deployment_events")
}

/// Transactional outbox (ADR-0004): written with the aggregate, dispatched to BullMQ by the relay.
model OutboxMessage {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([dispatchedAt, createdAt])
  @@map("outbox_messages")
}

/// `Idempotency-Key` replay store, scoped per organization, kept 24 h (docs/04).
model IdempotencyKey {
  orgId        String   @map("org_id") @db.Uuid
  key          String
  /// SHA-256 of method + route + body: the same key with a different request is a 409.
  requestHash  String   @map("request_hash") @db.Char(64)
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([orgId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Project-scoped inference key `mo_<prefix>_<secret>` (ADR-0006). Only an HMAC of the secret is stored.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String
  /// Public lookup id (the `<prefix>` part), safe to show and log.
  prefix      String    @unique
  /// HMAC-SHA256(pepper, secret)
  secretHash  Bytes     @map("secret_hash")
  scopes      String[]  @default(["predict"])
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([projectId, createdAt(sort: Desc)])
  @@map("api_keys")
}
