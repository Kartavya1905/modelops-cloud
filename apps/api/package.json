{
  "name": "@modelops/api",
  "version": "0.1.0",
  "private": true,
  "description": "ModelOps Cloud control-plane API (NestJS)",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker -c blue,green,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --enable-source-maps --env-file-if-exists=../../.env --watch --watch-preserve-output dist/main.js\" \"node --enable-source-maps --env-file-if-exists=../../.env --watch --watch-preserve-output dist/worker.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --enable-source-maps --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "openapi:emit": "node --enable-source-maps dist/openapi/emit.js ../../packages/api-contract/openapi.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "bullmq": "6.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
