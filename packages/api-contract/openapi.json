  "info": {
    "title": "ModelOps Cloud — Management API",
    "description": "Control-plane API. Errors use RFC 9457 problem+json. Mutating requests made with a session cookie must send the `X-CSRF-Token` header returned by `/api/v1/auth/me`.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mo_session"
      }
    },
    "schemas": {
      "AuditActorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "AuditEventDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Monotonic id (string, because it is a 64-bit integer)"
          },
          "actorType": {
            "type": "string",
            "enum": [
              "USER",
              "API_KEY",
              "SYSTEM"
            ]
          },
          "actor": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AuditActorDto"
              }
            ]
          },
          "action": {
            "type": "string",
            "example": "project.created"
          },
          "targetType": {
            "type": "string",
            "nullable": true
          },
          "targetId": {
            "type": "string",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "actorType",
          "actor",
          "action",
          "targetType",
          "targetId",
          "metadata",
          "requestId",
          "createdAt"
        ]
      },
      "AuditPageDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEventDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "At least 12 characters."
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "MembershipSummaryDto": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "orgName": {
            "type": "string"
          },
          "orgSlug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "ML_ENGINEER",
              "VIEWER"
            ]
          },
          "permissions": {
            "type": "array",
            "description": "For UI hints only.",
            "items": {
              "type": "string",
              "enum": [
                "org:read",
                "member:read",
                "member:manage",
                "invitation:create",
                "project:read",
                "project:create",
                "project:update",
                "project:archive",
                "audit:read"
              ]
            }
          }
        },
        "required": [
          "orgId",
          "orgName",
          "orgSlug",
          "role",
          "permissions"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipSummaryDto"
            }
          },
          "csrfToken": {
            "type": "string",
            "description": "Send as X-CSRF-Token on POST/PUT/PATCH/DELETE."
          }
        },
        "required": [
          "user",
          "memberships",
          "csrfToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "OrgDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "ML_ENGINEER",
              "VIEWER"
            ],
            "description": "Your role in this organization."
          },
          "memberCount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role",
          "memberCount",
          "createdAt"
        ]
      },
      "CreateOrgDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme ML",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "MemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "ML_ENGINEER",
              "VIEWER"
            ]
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "name",
          "email",
          "role",
