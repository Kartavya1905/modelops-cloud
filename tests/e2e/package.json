{
  "name": "@modelops/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end browser tests (Playwright) against the running stack",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "install-browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "screenshots": "node --experimental-strip-types screenshots.ts",
    "screenshots:grafana": "node --experimental-strip-types grafana-shots.ts",
    "demo:record": "node --experimental-strip-types demo-recording.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
