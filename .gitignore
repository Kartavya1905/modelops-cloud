# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.pyc

# Build output
dist/
.next/
out/
build/
*.tsbuildinfo
coverage/

# Generated code (recreated by `pnpm install` / `prisma generate`)
apps/api/src/generated/

# Secrets (generated by `pnpm env:init`, never committed)
.env
.env.*
!.env.example

# Local data and generated models
mlruns/
ml/artifacts/
*.onnx
!**/fixtures/**/*.onnx

# Test output
playwright-report/
test-results/
tests/load/results/*.tmp

# Machine-specific tool config (contains absolute paths)
.claude/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
